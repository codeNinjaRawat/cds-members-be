# BE on the server. Copy to BE/.env.production ON THE SERVER ONLY (never commit it, never put it on a PC).
# Check it before every deploy:   npm run check:production -- --env=production
# Every value marked CHANGE must be replaced. Make secrets with:   openssl rand -hex 32
NODE_ENV=production

## Database. The live database on the server (memory/database-environments.md › live). Migrations need the owner
## login; a separate, smaller API login comes before go-live (deploy/README.md › Before real members).
DATABASE_URL=postgresql://membership_owner:CHANGE@127.0.0.1:5432/membership
# same machine: disable · another machine: require (or verify-full + DATABASE_SSL_CA)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_APP_NAME=membership-api

## Addresses
PORT=4330
# only this server can reach the API (nginx forwards the public webhook addresses)
HOST=127.0.0.1
TENANT_FROM_HOST=1
BASE_DOMAIN=nextgrow.pro
DEFAULT_ORG=isgh
# nginx is in front: take the visitor's address from X-Forwarded-For
TRUST_PROXY=1
# the website/admin/panel servers pass this key with every call (MS_EDGE_KEY in their .env.production – same value)
EDGE_KEY=CHANGE
# the sites allowed to write with a sign-in cookie (comma separated, https only)
ALLOWED_ORIGINS=https://member-web.nextgrow.pro,https://member-admin.nextgrow.pro,https://saas.nextgrow.pro
# where emails link to
PUBLIC_SITE_URL=https://member-web.nextgrow.pro
ADMIN_URL_TEMPLATE=https://{slug}-admin.nextgrow.pro
PUBLIC_API_URL=https://be.nextgrow.pro

## Sign-in and security
AUTH_PEPPER=CHANGE
COOKIE_SECURE=1
PLATFORM_OWNER_EMAIL=CHANGE
GOOGLE_CLIENT_ID=
# NEVER on the server (the API refuses to start): AUTH_DEV_HEADER, AUTH_DEV_CODES, AUTH_DEV_FIXED_CODE,
# AUTH_DEV_NO_LIMITS, AUTH_GOOGLE_FAKE, LOCALHOST_ORG, DNS_FAKE

## Email and text messages (log = nothing is sent – sign-in codes need a real provider)
EMAIL_PROVIDER=postmark
MAIL_FROM=Masajid Solutions <no-reply@nextgrow.pro>
POSTMARK_TOKEN=CHANGE
EMAIL_WEBHOOK_TOKEN=CHANGE
SMS_PROVIDER=log
# TWILIO_SID= / TWILIO_TOKEN= / TWILIO_FROM= / TWILIO_MESSAGING_SERVICE=

## Card payments
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=CHANGE
STRIPE_WEBHOOK_SECRET=CHANGE
# a staging server without real payments instead: PAYMENTS_PROVIDER=fake and ALLOW_FAKE_PAYMENTS=1

## Files (uploads). local = a folder on the server (mounted as a volume, backed up) · s3 = object storage
FILES_STORAGE=local
FILES_DIR=/srv/files
# S3_ENDPOINT= / S3_REGION= / S3_BUCKET= / S3_KEY= / S3_SECRET=

## Worker
WORKER_EVERY_SECONDS=60
