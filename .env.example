# Copy to .env (never commit .env). Everything the API and the worker read, with what it is for.

## Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/membership
DATABASE_SSL=disable                 # disable (same machine) | require (encrypted, server's own certificate) | verify-full (+ DATABASE_SSL_CA)
# DATABASE_SSL_CA=                   # CA file for verify-full
# DATABASE_POOL_MAX=10               # connections per process
# DATABASE_CONNECT_TIMEOUT_MS=10000  # give up on an unreachable database after this
# DB_HEALTH_TIMEOUT_MS=10000         # how long GET /health and db:check wait for the database
# DATABASE_APP_NAME=membership-api   # the name shown in pgAdmin → Dashboard → Sessions
# Profiles: BE/.env.<name> is read before this file with --env=<name> or BE_ENV=<name>
#   server-dev = the DEV database on the membership server (copy .env.server-dev.example) – npm run server-dev:check
# DB_ADAPTER=psql            # only where npm is not available (sandbox / CI image with psql): same SQL through psql

## Addresses
PORT=4330
BASE_DOMAIN=nextgrow.pro              # <slug>.nextgrow.pro = website, <slug>-admin.nextgrow.pro = admin
TENANT_FROM_HOST=1                    # pick the organization from the Host header (production); otherwise x-org / DEFAULT_ORG
EDGE_KEY=                             # long random secret shared with the website, admin and mobile edge (openssl rand -hex 32):
                                      # with it they may send x-org-host / x-org and x-client-ip; without it those headers are ignored
TRUST_PROXY=1                         # nginx in front: the visitor's address is the last x-forwarded-for hop
DEFAULT_ORG=isgh
ALLOWED_ORIGINS=https://member-web.nextgrow.pro,https://member-admin.nextgrow.pro   # cookie writes only from these
PUBLIC_API_URL=https://api.nextgrow.pro       # local file links and Twilio signatures
# PUBLIC_SITE_URL=                    # force one website address in emails (tests / one-organization installs)
# ADMIN_URL_TEMPLATE=https://{slug}-admin.nextgrow.pro

## Sign-in and security
AUTH_PEPPER=change-me-to-64-random-characters    # codes and email links are bound to it – keep it secret, never change it casually
COOKIE_SECURE=1
# SESSION_COOKIE=ms_sid
# AUTH_CODES_PER_IP=20
GOOGLE_CLIENT_ID=                      # Google sign-in (optional)
PLATFORM_OWNER_EMAIL=you@masajidsolutions.com   # the first SaaS-panel owner; everyone else is added in the panel
# never in production: AUTH_DEV_HEADER=1 (x-admin / x-staff test headers), AUTH_DEV_CODES=1 (codes in answers), AUTH_GOOGLE_FAKE=1

## Email and text messages (pick one provider each; "log" sends nothing)
EMAIL_PROVIDER=log                     # log | postmark | sendgrid | resend
MAIL_FROM=notices@nextgrow.pro         # the platform's sending address (organizations' names and reply-to come from their settings)
POSTMARK_TOKEN=
SENDGRID_KEY=
RESEND_KEY=
EMAIL_WEBHOOK_TOKEN=                   # the provider's webhook calls /webhooks/email/<provider> with this token
SMS_PROVIDER=log                       # log | twilio
TWILIO_SID=
TWILIO_TOKEN=                          # also verifies /webhooks/sms/twilio
TWILIO_FROM=                           # or TWILIO_MESSAGING_SERVICE=
TWILIO_MESSAGING_SERVICE=

## Card payments (dues, events, gifts) – each organization's own Stripe account
PAYMENTS_PROVIDER=fake                 # fake | stripe
STRIPE_SECRET_KEY=                     # default key; per organization: STRIPE_SECRET_KEY_<SLUG> (e.g. STRIPE_SECRET_KEY_ISGH)
STRIPE_WEBHOOK_SECRET=                 # /webhooks/pay/stripe

## Files (uploads: minutes, records, photo IDs, event pictures)
FILES_STORAGE=local                    # local | s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
FILES_DIR=./data/files
S3_ENDPOINT=                           # empty for AWS; https://<account>.r2.cloudflarestorage.com for R2
S3_REGION=auto
S3_BUCKET=
S3_KEY=
S3_SECRET=

## Worker
WORKER_EVERY_SECONDS=60
# DNS_FAKE=1                           # tests only: own-domain checks without DNS
