# Profile "server-dev": this PC (API, migrate, seed, checks) against the DEV database on the membership server.
# Copy to BE/.env.server-dev (never committed – .gitignore), replace YOUR_DEV_PASSWORD (🔑 DEV password), then:
#   npm run server-dev:check      read-only: reachable? encrypted? roles? migrations?
#   npm run server-dev:migrate    create / update the tables
#   npm run server-dev:seed       ISGH (client #1) starter documents + demo members
#   npm run server-dev:test-sql   SQL white-box tests (refuses the live database)
#   npm run dev:server-db         the API on http://localhost:4330 using this database
# Only what is set here changes; everything else still comes from BE/.env.
# Password with special characters (@ : / ? # %)? URL-encode them (e.g. @ → %40) or pick a password without them.

DATABASE_URL=postgresql://membership_dev_owner:YOUR_DEV_PASSWORD@3.18.46.122:5432/membership_dev
DATABASE_SSL=require                  # encrypted; the server uses PostgreSQL's own (self-signed) certificate for now
DATABASE_APP_NAME=membership-api-pc   # how this PC shows in pgAdmin → Dashboard → Sessions
DATABASE_POOL_MAX=5                   # the dev database is shared – keep a small pool per PC
